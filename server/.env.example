# Copy to .env and replace with your own credentials. Never commit real secrets.
DATABASE_URL="mysql://root:<your-password>@localhost:3306/smartserve"
JWT_SECRET="generate-with: openssl rand -hex 32"
JWT_EXPIRES_IN="2h"
PORT=5001
# Comma-separated list of allowed browser origins for CORS (credentials enabled).
CORS_ORIGIN="http://localhost:5173"
# Public base URL used in emails and upload responses. Leave unset in dev (defaults to localhost:5000).
APP_URL="http://localhost:5000"
RESEND_API_KEY=""
RESEND_FROM=""
